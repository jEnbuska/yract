{
  "name": "yract-playground",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test --project=chromium --project=firefox --project=webkit; quick=$?; playwright test --project=chromium-table --project=firefox-table --project=webkit-table --workers=1; heavy=$?; exit $((quick || heavy))",
    "test:visual": "playwright test --ui",
    "playwright": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "playwright:install": "playwright install --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.3.0",
    "@types/web": "^0.0.354",
    "typescript": "^7.0.2",
    "vite": "^8.0.8"
  }
}
