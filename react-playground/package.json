    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxc-transform-react": "^0.145.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.8"
  }
}
